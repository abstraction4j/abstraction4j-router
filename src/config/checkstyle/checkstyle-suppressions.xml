<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
		"-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
		"https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
	<!-- Test sources don't need Javadoc. -->
	<suppress files="[\\/]src[\\/]test[\\/]java[\\/]" checks="Javadoc*" />
	<!-- Deliberately overloads equals(String) to test that the router passes it through. -->
	<suppress files="[\\/]JdkAbstractionRoutersTests\.java$" checks="CovariantEquals" />
</suppressions>
